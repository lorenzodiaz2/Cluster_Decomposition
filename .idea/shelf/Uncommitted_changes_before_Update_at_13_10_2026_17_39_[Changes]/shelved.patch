+def plot_frequency_gap(df):
+    # --- Grafico: Frequenza dei Valori di Gap per Range (es. 0-10, 10-20) ---
+    # Trova il massimo e minimo per definire dinamicamente i "bin" (intervalli di 10)
+    max_gap = max(0, df['gap'].max())
+    min_gap = min(0, df['gap'].min())
+    bins = np.arange(np.floor(min_gap / 10) * 10, np.ceil(max_gap / 10) * 10 + 10, 10)
+
+    plt.figure(figsize=(10, 6))
+    # Crea l'istogramma di base per mostrare i range
+    out, bins_edges, patches = plt.hist(df['gap'], bins=bins, color='skyblue', edgecolor='black')
+
+    # Calcola il punto centrale di ogni range per disegnare la linea di tendenza continua
+    bin_centers = 0.5 * (bins_edges[:-1] + bins_edges[1:])
+    plt.plot(bin_centers, out, marker='o', linestyle='-', color='red', linewidth=2)
+
+    plt.xticks(bins)
+    plt.title('Frequenza del Gap per Range (0-10, 10-20, ...)')
+    plt.xlabel('Range del Gap')
+    plt.ylabel('Frequenza (Numero di istanze)')
+    plt.grid(True, axis='y')
+    plt.show()
+
+
+def plot_optimization_csv(csv_path, gap_out="gap_plot.png", speedup_out="speedup_plot.png"):
+    # 1. Lettura dati
+    df = pd.read_csv(csv_path)
+    df = df[df["status heuristic"] == "OPTIMAL"]
+    df = df[df["mean resource capacity"].isin([5, 6])]
+
+
+    # 2. Raggruppamento per tipologia di istanza e calcolo della mediana (aggrega i vari seed)
+    agg_df = df.groupby(['n quadrants', 'n pairs per quadrant', 'offset'])[['gap', 'speedup']].median().reset_index()
+
+    # 3. Calcolo dimensione istanza per la colorbar
+    agg_df['size'] = agg_df['n quadrants'] * agg_df['n pairs per quadrant']
+    min_size = agg_df['size'].min()
+    max_size = agg_df['size'].max()
+
+    # 4. Impostazioni mappa colori
+    cmap = mpl.colormaps["cividis"]
+    norm = mcolors.Normalize(vmin=min_size, vmax=max_size)
+
+    # Raggruppo per singola linea da disegnare (combinazione univoca di quadrants e pairs)
+    curves = agg_df.groupby(['n quadrants', 'n pairs per quadrant'])
+
+    # Funzione di supporto per evitare duplicazioni di codice tra i due plot
+    def create_plot(y_column, y_label, output_file):
+        plt.figure(figsize=(14, 10))
+        y_limit = 0
+
+        for (n_quads, n_pairs), group in curves:
+            # Ordino per offset per evitare linee "a zig zag"
+            group = group.sort_values('offset')
+            color = cmap(norm(n_quads * n_pairs))
+
+            plt.plot(group['offset'], group[y_column], marker='o', linestyle='-',
