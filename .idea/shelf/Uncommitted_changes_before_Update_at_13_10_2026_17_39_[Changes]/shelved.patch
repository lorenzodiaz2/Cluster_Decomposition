+def plot_repair_statistics(csv_path, unassigned_out="unassigned_plot.png", repair_out="repair_plot.png"):
+    # 1. Lettura dati e filtri iniziali
+    df = pd.read_csv(csv_path)
+    df = df[df["status heuristic"] == "OPTIMAL"]
+    df = df[df["mean resource capacity"].isin([5, 6])]
+
+    # 1.5 Calcolo delle nuove metriche
+
+    # Se 'final unassigned agents' è NaN nei log, forziamo il valore a 0
+    df['final unassigned agents'] = df['final unassigned agents'].fillna(0)
+    df['unassigned_ratio'] = df['final unassigned agents'] / df['n agents'] * 100
+
+    # Funzione di appoggio per convertire la stringa e sommare gli elementi.
+    # Se la cella è vuota (NaN), restituisce direttamente 0.
+    def parse_and_sum(val):
+        if pd.isna(val):
+            return 0
+        try:
+            return sum(ast.literal_eval(str(val)))
+        except Exception:
+            return 0
+
+    def calc_repair_ratio(row):
+        total_sum = parse_and_sum(row['model times repair']) + parse_and_sum(row['resolution times repair'])
+
+        # Ritorna 0 per evitare divisioni per zero se 'time heuristic' dovesse essere esattamente 0
+        if row['time heuristic'] == 0:
+            return 0
+
+        return (total_sum / row['time heuristic']) * 100
+
+    df['repair_time_ratio'] = df.apply(calc_repair_ratio, axis=1)
+
+    # 2. Raggruppamento per tipologia di istanza e calcolo della mediana (aggrega i vari seed)
+    agg_df = df.groupby(['n quadrants', 'n pairs per quadrant', 'offset'])[
